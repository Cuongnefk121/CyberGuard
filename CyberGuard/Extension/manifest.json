{
    "manifest_version": 3,

    "name": "CyberGuard",

    "version": "1.1.0",

    "description": "CyberGuard website security protection",

    "permissions": [
        "tabs",
        "storage",
        "webNavigation"
    ],

    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:8080/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html"
    },

    "web_accessible_resources": [
        {
            "resources": [
                "check.html",
                "warning.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}